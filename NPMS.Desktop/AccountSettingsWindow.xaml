<Window x:Class="NPMS.Desktop.AccountSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account Settings — NPMS" Height="520" Width="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC"
        FontFamily="Segoe UI" FontSize="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="24,0">
            <TextBlock Text="Account Settings" FontSize="16" FontWeight="Bold"
                       Foreground="#111827" VerticalAlignment="Center"/>
        </Border>

        <!-- Body -->
        <StackPanel Grid.Row="1" Margin="28,24">

            <!-- User Management Panel (R&D Team only) -->
            <StackPanel x:Name="UserManagementPanel" Margin="0,0,0,16">

                <!-- Title + Add button -->
                <Grid Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="User Accounts" FontSize="15" FontWeight="SemiBold" Foreground="#111827"/>
                        <TextBlock Text="Manage who can access this application"
                                   FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="#6D28D9" CornerRadius="6">
                        <Button Content="+ Add User" Click="BtnAddUser_Click"
                                Height="36" Padding="16,0" Background="Transparent"
                                Foreground="White" FontWeight="SemiBold" FontSize="13"
                                BorderThickness="0" Cursor="Hand"/>
                    </Border>
                </Grid>

                <!-- User Table -->
                <Border Background="White" BorderBrush="#DCDCDC"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Background="#F9FAFB" Height="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="USERNAME" FontSize="10" FontWeight="Bold" Foreground="#6B7280"
                                       Margin="16,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="ROLE" FontSize="10" FontWeight="Bold"
                                       Foreground="#6B7280" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="STATUS" FontSize="10" FontWeight="Bold"
                                       Foreground="#6B7280" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="ACTIONS" FontSize="10" FontWeight="Bold"
                                       Foreground="#6B7280" VerticalAlignment="Center"/>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="330">
                            <ItemsControl x:Name="UserList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F3F4F6" BorderThickness="0,1,0,0">
                                            <Grid MinHeight="44">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="220"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Username}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Margin="16,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding RoleName}"
                                                           FontSize="12" Foreground="#374151"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                                                           FontSize="12" Foreground="{Binding StatusColor}"
                                                           VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Edit" Click="BtnEditUser_Click"
                                                            Background="Transparent" Foreground="#6D28D9"
                                                            BorderThickness="0" FontSize="12" Cursor="Hand"
                                                            Margin="0,0,8,0" DataContext="{Binding}"/>
                                                    <Button Content="Delete" Click="BtnDeleteUser_Click"
                                                            Background="Transparent" Foreground="#DC2626"
                                                            BorderThickness="0" FontSize="12" Cursor="Hand"
                                                            DataContext="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
