<Window x:Class="NPMS.Desktop.AddUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New User" Height="420" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Add New User" FontSize="15" FontWeight="Bold"
                   Foreground="#111827" Margin="0,0,0,24"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,24">
            <TextBlock Text="Username" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtUsername" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                     BorderBrush="#D1D5DB" BorderThickness="1" FontSize="13" Margin="0,0,0,14"/>

            <TextBlock Text="Password" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtPassword" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                         BorderBrush="#D1D5DB" BorderThickness="1" FontSize="13" Margin="0,0,0,14"/>

            <TextBlock Text="Role" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbRole" Height="36" BorderBrush="#D1D5DB" FontSize="13"
                      Background="White" Padding="8,0" VerticalContentAlignment="Center"/>

            <TextBlock x:Name="TxtError" Text="" Foreground="#DC2626" FontSize="12"
                       Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Button Content="Cancel" Click="BtnCancel_Click" HorizontalAlignment="Left"
                    Width="90" Height="36" Background="White" Foreground="#374151"
                    BorderBrush="#D1D5DB" BorderThickness="1" Cursor="Hand"/>
            <Border HorizontalAlignment="Right" Background="#2563EB" CornerRadius="6">
                <Button Content="Add User" Click="BtnAdd_Click"
                        Width="110" Height="36" Background="Transparent"
                        Foreground="White" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand"/>
            </Border>
        </Grid>
    </Grid>
</Window>
