<Window x:Class="NPMS.Desktop.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password" Height="320" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI" FontSize="12">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,20">
            <TextBlock Text="Change Password" FontSize="17" FontWeight="Bold"
                       Foreground="#111827"/>
        </Border>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Current Password" FontSize="11" FontWeight="SemiBold"
                       Foreground="#6B7280" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtCurrentPwd" Height="34" Padding="10,0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,12"/>

            <TextBlock Text="New Password" FontSize="11" FontWeight="SemiBold"
                       Foreground="#6B7280" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtNewPwd" Height="34" Padding="10,0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,12"/>

            <TextBlock Text="Confirm New Password" FontSize="11" FontWeight="SemiBold"
                       Foreground="#6B7280" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtConfirmPwd" Height="34" Padding="10,0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#D1D5DB" BorderThickness="1"/>

            <TextBlock x:Name="TxtError" Text="" Foreground="#DC2626" FontSize="12"
                       Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Button Content="Cancel" Click="BtnCancel_Click" HorizontalAlignment="Left"
                    Width="90" Height="34" Background="White" Foreground="#374151"
                    BorderBrush="#D1D5DB" BorderThickness="1" Cursor="Hand"/>
            <Border HorizontalAlignment="Right" Background="#6D28D9" CornerRadius="6">
                <Button Content="Save Password" Click="BtnSave_Click"
                        Width="120" Height="34" Background="Transparent"
                        Foreground="White" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand"/>
            </Border>
        </Grid>
    </Grid>
</Window>
