<Window x:Class="NPMS.Desktop.EditUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit User" Height="400" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F9FAFB">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
            <TextBlock Text="Edit User" FontSize="17" FontWeight="Bold" Foreground="#111827"/>
        </Border>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Username" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtUsername" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                     BorderBrush="#D1D5DB" BorderThickness="1" FontSize="13" Foreground="#374151"
                     Margin="0,0,0,14"/>
            <TextBlock Text="Role" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbRole" Height="36" Padding="8,0" VerticalContentAlignment="Center"
                      BorderBrush="#D1D5DB" BorderThickness="1" FontSize="13"
                      Foreground="#374151" Background="White" Margin="0,0,0,14"/>
            <CheckBox x:Name="ChkActive" Content="Active account" FontSize="12"
                      Foreground="#374151"/>
            <TextBlock x:Name="TxtError" Text="" Foreground="#DC2626" FontSize="12"
                       Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Button Content="Cancel" Click="BtnCancel_Click" HorizontalAlignment="Left"
                    Width="90" Height="36" Background="White" Foreground="#374151"
                    BorderBrush="#D1D5DB" BorderThickness="1" Cursor="Hand"/>
            <Button Content="Change Password" Click="BtnChangePassword_Click"
                    HorizontalAlignment="Center" Width="130" Height="36"
                    Background="White" Foreground="#6D28D9"
                    BorderBrush="#D1D5DB" BorderThickness="1" Cursor="Hand"/>
            <Border HorizontalAlignment="Right" Background="#6D28D9" CornerRadius="4">
                <Button Content="Save Changes" Click="BtnSave_Click"
                        Width="120" Height="36" Background="Transparent"
                        Foreground="White" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand"/>
            </Border>
        </Grid>
    </Grid>
</Window>
