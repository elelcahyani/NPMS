<Window x:Class="NPMS.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign In — NPMS" Height="265" Width="390"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F3F3"
        FontFamily="Segoe UI" FontSize="12"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#3B0764" BorderThickness="0,0,0,1" Padding="18,13">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#20063B" Offset="0.0"/>
                    <GradientStop Color="#4C1D95" Offset="0.5"/>
                    <GradientStop Color="#7C3AED" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#3B1261" CornerRadius="6" Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" FontSize="18" Foreground="#F3E8FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="NPMS Sign In" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Enter your credentials to continue" FontSize="11" Foreground="#E9D5FF" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form Body -->
        <Grid Grid.Row="1" Margin="20,16,20,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Username -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Foreground="#374151" FontSize="12"/>
            <TextBox x:Name="TxtUsername" Grid.Row="0" Grid.Column="1" Height="26" VerticalContentAlignment="Center"
                     Padding="6,0" BorderBrush="#C4B5FD" BorderThickness="1" Background="White" FontSize="12"
                     Margin="0,0,0,10" KeyDown="Input_KeyDown"/>

            <!-- Password -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Foreground="#374151" FontSize="12"/>
            <PasswordBox x:Name="TxtPassword" Grid.Row="1" Grid.Column="1" Height="26" VerticalContentAlignment="Center"
                         Padding="6,0" BorderBrush="#C4B5FD" BorderThickness="1" Background="White" FontSize="12"
                         KeyDown="Input_KeyDown"/>

            <!-- Error message -->
            <TextBlock x:Name="TxtError" Grid.Row="2" Grid.Column="1" Foreground="#DC2626" FontSize="11"
                       Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
        </Grid>

        <!-- Footer / Hint -->
        <Border Grid.Row="2" Background="#F5F3FF" BorderBrush="#EDE9FE" BorderThickness="0,1,0,0" Padding="16,8">
            <TextBlock Text="Press Enter to sign in" HorizontalAlignment="Right" Foreground="#6D28D9" FontSize="11" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
