<Window x:Class="NPMS.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NPMS — Login" Height="480" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid>
        <Border VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
            <StackPanel>
                <!-- Logo / Title -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                    <Border Background="#2563EB" CornerRadius="12" Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7EF;" Foreground="White"
                                   FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="NPMS" FontSize="24" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                    <TextBlock Text="New Product Management System" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Form -->
                <TextBlock Text="Username" FontSize="13" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtUsername" Height="38" Padding="10,0" VerticalContentAlignment="Center"
                         BorderBrush="#D1D5DB" BorderThickness="1" FontSize="13"
                         KeyDown="Input_KeyDown"/>

                <TextBlock Text="Password" FontSize="13" FontWeight="SemiBold" Foreground="#374151" Margin="0,16,0,6"/>
                <PasswordBox x:Name="TxtPassword" Height="38" Padding="10,0" VerticalContentAlignment="Center"
                             BorderBrush="#D1D5DB" BorderThickness="1" FontSize="13"
                             KeyDown="Input_KeyDown"/>

                <TextBlock x:Name="TxtError" Text="" Foreground="#DC2626" FontSize="12"
                           Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

                <Border Background="#2563EB" CornerRadius="6" Margin="0,20,0,0">
                    <Button x:Name="BtnLogin" Content="Login" Click="BtnLogin_Click"
                            Height="40" Background="Transparent" Foreground="White"
                            FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand"/>
                </Border>

            </StackPanel>
        </Border>
    </Grid>
</Window>
