<Window x:Class="NPMS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="New Product Management System (NPMS)" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC">
    <Window.Resources>
        <Style x:Key="FilterComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ProcessTabStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#1B2A3B">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,24,20,24">
                    <TextBlock Text="NPMS" Foreground="White" FontSize="20" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="8,0,8,0">
                    <Border x:Name="NavDashboardBorder" Background="#2563EB" CornerRadius="6" Margin="0,0,0,4">
                        <Button x:Name="BtnNavDashboard" Click="NavDashboard_Click"
                                Height="38" Background="Transparent" Foreground="White"
                                BorderThickness="0" HorizontalContentAlignment="Left"
                                Padding="12,0,0,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;"
                                           FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border Background="Transparent" CornerRadius="6" Margin="0,0,0,4">
                        <Button x:Name="BtnNavStore" Click="NavStore_Click"
                                Height="38" Background="Transparent" Foreground="#94A3B8"
                                BorderThickness="0" HorizontalContentAlignment="Left"
                                Padding="12,0,0,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE719;"
                                           FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Store" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border Background="Transparent" CornerRadius="6">
                        <Button x:Name="BtnNavSettings" Click="NavSettings_Click"
                                Height="38" Background="Transparent" Foreground="#94A3B8"
                                BorderThickness="0" HorizontalContentAlignment="Left"
                                Padding="12,0,0,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE716;"
                                           FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Account Settings" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>

                <!-- User Profile -->
                <Border Grid.Row="2" Padding="16,12" BorderBrush="#2D3F50" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17" Background="#374151" Margin="0,0,10,0">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;"
                                       Foreground="White" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtUserName" Text="User" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock x:Name="TxtUserRole" Text="Role" Foreground="#64748B" FontSize="11"/>
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="BtnLogout" Click="BtnLogout_Click"
                                ToolTip="Logout" Background="Transparent" BorderThickness="0"
                                Foreground="#64748B" Cursor="Hand" Padding="4">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xF3B1;" FontSize="14"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="28,0,20,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="New Product Management System" FontSize="17" FontWeight="Bold"
                               Foreground="#111827" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6"
                            Background="White" Width="300" Height="36" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;"
                                       Foreground="#9CA3AF" FontSize="13"
                                       Margin="10,0,6,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtSearch" Grid.Column="1"
                                     Text="Search Part Number or Product Name..."
                                     Foreground="#6B7280" FontSize="12"
                                     VerticalContentAlignment="Center" Padding="0,0,10,0"
                                     BorderThickness="0" Background="Transparent"
                                     GotFocus="TxtSearch_GotFocus" LostFocus="TxtSearch_LostFocus"
                                     KeyUp="TxtSearch_KeyUp"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Width="36" Height="36" CornerRadius="18"
                            BorderBrush="#E5E7EB" BorderThickness="1" Background="#F9FAFB">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;"
                                   FontSize="16" Foreground="#374151"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1" Background="#F9FAFB">

                <!-- LIST VIEW -->
                <Grid x:Name="ViewList" Visibility="Visible" Margin="28,24,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Breadcrumb -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Dashboard" Foreground="#6B7280" FontSize="12"/>
                        <TextBlock Text=" > " Foreground="#6B7280" FontSize="12"/>
                        <TextBlock Text="Product Database" Foreground="#374151" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Title + Add Button -->
                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Product Database" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                            <TextBlock Text="Search and manage product information"
                                       Foreground="#6B7280" FontSize="13" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border x:Name="BtnAddProductBorder" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="#2563EB" CornerRadius="6" Visibility="Collapsed">
                            <Button x:Name="BtnAddProduct" Click="BtnAddProduct_Click"
                                    Content="+ Add New Product" Height="38" Padding="16,0"
                                    Background="Transparent" Foreground="White"
                                    FontWeight="SemiBold" FontSize="13" BorderThickness="0" Cursor="Hand"/>
                        </Border>
                    </Grid>

                    <!-- Filter Bar -->
                    <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                            CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="CmbFilterPartType" Style="{StaticResource FilterComboStyle}"
                                          Width="150" Margin="0,0,10,0" SelectionChanged="Filter_SelectionChanged">
                                    <ComboBoxItem Content="All Part Numbers" IsSelected="True"/>
                                    <ComboBoxItem Content="Inductor"/>
                                    <ComboBoxItem Content="Transformer"/>
                                    <ComboBoxItem Content="Sensor"/>
                                    <ComboBoxItem Content="Choke"/>
                                </ComboBox>
                                <ComboBox x:Name="CmbFilterFamily" Style="{StaticResource FilterComboStyle}"
                                          Width="170" Margin="0,0,10,0" SelectionChanged="Filter_SelectionChanged">
                                    <ComboBoxItem Content="All Product Families" IsSelected="True"/>
                                    <ComboBoxItem Content="Magnetic Components"/>
                                    <ComboBoxItem Content="Sensing Components"/>
                                </ComboBox>
                                <ComboBox x:Name="CmbFilterStatus" Style="{StaticResource FilterComboStyle}"
                                          Width="140" Margin="0,0,10,0" SelectionChanged="Filter_SelectionChanged">
                                    <ComboBoxItem Content="All Statuses" IsSelected="True"/>
                                    <ComboBoxItem Content="Released"/>
                                    <ComboBoxItem Content="Draft"/>
                                    <ComboBoxItem Content="In Development"/>
                                    <ComboBoxItem Content="Obsolete"/>
                                    <ComboBoxItem Content="Discontinued"/>
                                    <ComboBoxItem Content="Pending Review"/>
                                </ComboBox>
                                <ComboBox x:Name="CmbFilterFactory" Style="{StaticResource FilterComboStyle}"
                                          Width="150" Margin="0,0,10,0" SelectionChanged="Filter_SelectionChanged">
                                    <ComboBoxItem Content="All Factories" IsSelected="True"/>
                                    <ComboBoxItem Content="Bintan"/>
                                    <ComboBoxItem Content="Alpha Facility"/>
                                    <ComboBoxItem Content="Beta Facility"/>
                                    <ComboBoxItem Content="Gamma Facility"/>
                                    <ComboBoxItem Content="Delta Facility"/>
                                    <ComboBoxItem Content="Epsilon Facility"/>
                                </ComboBox>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Click="BtnClearFilters_Click"
                                    Content="Clear Filters" Background="Transparent"
                                    Foreground="#2563EB" FontWeight="SemiBold" FontSize="13"
                                    BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Product Table -->
                    <Border Grid.Row="3" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
                        <DataGrid x:Name="GridProducts" AutoGenerateColumns="False"
                                  IsReadOnly="True" GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column" RowHeight="48"
                                  Background="White" BorderThickness="0"
                                  HorizontalGridLinesBrush="#F3F4F6"
                                  ColumnHeaderHeight="40" SelectionMode="Single"
                                  HorizontalScrollBarVisibility="Auto"
                                  MouseDoubleClick="GridProducts_MouseDoubleClick">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#6B7280"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="14,0,0,0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F8FAFF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#EFF6FF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="14,0,0,0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#111827"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Trigger>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="PART NUMBER" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PartNumber}"
                                                       Foreground="#2563EB" FontWeight="SemiBold"
                                                       FontSize="13" VerticalAlignment="Center"
                                                       Margin="14,0,0,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="PRODUCT NAME" Binding="{Binding ProductName}" Width="160" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="PRODUCT FAMILY" Binding="{Binding ProductFamily}" Width="*"/>
                                <DataGridTextColumn Header="PRODUCT GROUP" Binding="{Binding ProductGroup}" Width="*"/>
                                <DataGridTextColumn Header="PRODUCT TYPE" Binding="{Binding ProductType}" Width="120"/>
                                <DataGridTemplateColumn Header="STATUS" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold"
                                                       FontSize="13" VerticalAlignment="Center"
                                                       Margin="14,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#374151"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Released">
                                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Draft">
                                                                <Setter Property="Foreground" Value="#6B7280"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="In Development">
                                                                <Setter Property="Foreground" Value="#2563EB"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Pending Review">
                                                                <Setter Property="Foreground" Value="#D97706"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Obsolete">
                                                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Discontinued">
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="FACTORY" Binding="{Binding Factory}" Width="130"/>
                                <DataGridTemplateColumn Header="LAST MODIFIED" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LastModified, StringFormat='{}{0:dd MMM yyyy}'}"
                                                       FontSize="12" Foreground="#6B7280"
                                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- DETAIL VIEW -->
                <Grid x:Name="ViewDetail" Visibility="Collapsed" Margin="28,20,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Breadcrumb + Back -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Dashboard" Foreground="#6B7280" FontSize="12"/>
                            <TextBlock Text=" > " Foreground="#6B7280" FontSize="12"/>
                            <TextBlock Text="Search Results" Foreground="#6B7280" FontSize="12"/>
                            <TextBlock Text=" > " Foreground="#6B7280" FontSize="12"/>
                            <TextBlock x:Name="BreadcrumbProduct" Foreground="#374151" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button x:Name="BtnBackToList" Click="BtnBackToList_Click"
                                Content="&lt;- Back to Search Results"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#2563EB" FontSize="12" FontWeight="SemiBold"
                                HorizontalAlignment="Left" Cursor="Hand" Padding="0"/>
                    </StackPanel>

                    <!-- Detail Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Column -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">

                                <!-- Header Card -->
                                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                        CornerRadius="8" Padding="20" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="0,0,0,16">
                                            <TextBlock x:Name="DetailTitle" FontSize="20" FontWeight="Bold"
                                                       Foreground="#111827" VerticalAlignment="Center"/>
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <Border x:Name="BtnDeleteProductBorder" Background="White"
                                                        BorderBrush="#FCA5A5" BorderThickness="1"
                                                        CornerRadius="6" Visibility="Collapsed" Margin="0,0,8,0">
                                                    <Button x:Name="BtnDeleteProduct" Click="BtnDeleteProduct_Click"
                                                            Height="32" Width="32"
                                                            Background="Transparent" Foreground="#DC2626"
                                                            BorderThickness="0" Cursor="Hand" ToolTip="Delete Product">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="14"/>
                                                    </Button>
                                                </Border>
                                                <Border x:Name="BtnEditProductBorder" Background="White"
                                                        BorderBrush="#D1D5DB" BorderThickness="1"
                                                        CornerRadius="6" Visibility="Collapsed">
                                                    <Button x:Name="BtnEditProduct" Click="BtnEditProduct_Click"
                                                            Height="32" Padding="12,0"
                                                            Background="Transparent" Foreground="#374151"
                                                            FontSize="12" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;"
                                                                       FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Edit Product" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Border>
                                                <Border x:Name="BadgeAccess" Background="#F1F5F9" BorderBrush="#CBD5E1"
                                                        BorderThickness="1" CornerRadius="12" Padding="10,4"
                                                        Visibility="Collapsed">
                                                    <TextBlock Text="Read-only Access" Foreground="#64748B"
                                                               FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="100" Height="90" CornerRadius="6"
                                                    Background="#F3F4F6" BorderBrush="#E5E7EB"
                                                    BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Top">
                                                <Grid>
                                                    <TextBlock x:Name="TxtNoImage" Text="No Image" FontSize="11" Foreground="#9CA3AF"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               TextAlignment="Center"/>
                                                    <Image x:Name="ImgProduct" Stretch="Uniform"
                                                           Visibility="Collapsed"/>
                                                </Grid>
                                            </Border>
                                            <Grid Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,10">
                                                    <TextBlock Text="PART NUMBER" FontSize="9" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="TxtDetailPn" FontSize="13" FontWeight="Bold" Foreground="#2563EB"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                                    <TextBlock Text="PRODUCT NAME" FontSize="9" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="TxtDetailName" FontSize="13" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,10">
                                                    <TextBlock Text="PRODUCT FAMILY" FontSize="9" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="TxtDetailFamily" FontSize="13"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                                    <TextBlock Text="PRODUCT GROUP" FontSize="9" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="TxtDetailGroup" FontSize="13"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,10">
                                                    <TextBlock Text="PRODUCT TYPE" FontSize="9" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="TxtDetailType" FontSize="13"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                                                    <TextBlock Text="STATUS" FontSize="9" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="TxtDetailStatus" FontSize="13" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                                    <TextBlock Text="CURRENT PRODUCT REVISION" FontSize="9" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="TxtDetailRevision" FontSize="13"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                                    <TextBlock Text="DESCRIPTION" FontSize="9" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="TxtDetailDesc" FontSize="12" TextWrapping="Wrap" Foreground="#374151"/>
                                                </StackPanel>
                                                <Grid Grid.Row="5" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="CREATED BY" FontSize="9" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                                        <TextBlock x:Name="TxtDetailCreatedBy" FontSize="11" Foreground="#6B7280"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="LAST MODIFIED" FontSize="9" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                                        <TextBlock x:Name="TxtDetailUpdatedAt" FontSize="11" Foreground="#6B7280"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Manufacturing Info -->
                                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                        CornerRadius="8" Padding="20" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Manufacturing Information" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,14"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Factory" FontSize="11" Foreground="#6B7280" Margin="0,0,0,3"/>
                                                <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="8,6" Background="#F9FAFB">
                                                    <TextBlock x:Name="TxtDetailFactory" FontSize="13"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Production Line" FontSize="11" Foreground="#6B7280" Margin="0,0,0,3"/>
                                                <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="8,6" Background="#F9FAFB">
                                                    <TextBlock x:Name="TxtDetailLine" FontSize="13"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="Production Type" FontSize="11" Foreground="#6B7280" Margin="0,0,0,3"/>
                                            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="8,6" Background="#F9FAFB" Width="220" HorizontalAlignment="Left">
                                                <TextBlock x:Name="TxtDetailProdType" FontSize="13"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Manufacturing Notes" FontSize="11" Foreground="#6B7280" Margin="0,0,0,3"/>
                                            <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="8,6" Background="#F9FAFB">
                                                <TextBlock x:Name="TxtDetailMfgNotes" FontSize="12" TextWrapping="Wrap" Foreground="#374151"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Process Flow -->
                                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                        CornerRadius="8" Padding="20" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Process Flow" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,12"/>
                                        <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                            <WrapPanel x:Name="DetailProcessTabBar" Orientation="Horizontal"/>
                                        </Border>
                                        <Border x:Name="DetailProcessPanel" Margin="0,12,0,0"
                                                BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="16"
                                                Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="Process Details" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Process Name" FontSize="11" Foreground="#6B7280" Margin="0,0,0,3"/>
                                                        <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="8,6" Background="#F9FAFB">
                                                            <TextBlock x:Name="DetailProcessName" FontSize="13"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Machine" FontSize="11" Foreground="#6B7280" Margin="0,0,0,3"/>
                                                        <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="8,6" Background="#F9FAFB">
                                                            <TextBlock x:Name="DetailMachine" FontSize="13"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Margin="0,0,0,10">
                                                    <TextBlock Text="Tooling" FontSize="11" Foreground="#6B7280" Margin="0,0,0,3"/>
                                                    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="8,6" Background="#F9FAFB" Width="220" HorizontalAlignment="Left">
                                                        <TextBlock x:Name="DetailTooling" FontSize="13"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,0,14">
                                                    <TextBlock Text="Process Description" FontSize="11" Foreground="#6B7280" Margin="0,0,0,3"/>
                                                    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="8,6" Background="#F9FAFB">
                                                        <TextBlock x:Name="DetailProcessDesc" FontSize="12" TextWrapping="Wrap"/>
                                                    </Border>
                                                </StackPanel>
                                                <!-- Parameters Table -->
                                                <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4">
                                                    <StackPanel>
                                                        <Grid Background="#F9FAFB" Height="34">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="100"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Parameter" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="12,0" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="Value" FontSize="10" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="Unit" FontSize="10" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <ItemsControl x:Name="DetailParamList">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="#F3F4F6" BorderThickness="0,1,0,0">
                                                                        <Grid Height="34">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="120"/>
                                                                                <ColumnDefinition Width="100"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding ParameterName}" FontSize="12" Margin="12,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding ParameterValue}" FontSize="12" VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="2" Text="{Binding Unit}" FontSize="12" VerticalAlignment="Center" Foreground="#6B7280"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Supporting Documents -->
                                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                        CornerRadius="8" Padding="20">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <TextBlock Text="Supporting Documents" FontSize="14"
                                                       FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center"/>
                                            <Border x:Name="BtnUploadDocBorder" HorizontalAlignment="Right"
                                                    Background="White" BorderBrush="#D1D5DB"
                                                    BorderThickness="1" CornerRadius="4"
                                                    Visibility="Collapsed">
                                                <Button x:Name="BtnUploadDoc" Content="Upload Document"
                                                        Click="BtnUploadDoc_Click"
                                                        Height="30" Padding="12,0" Background="Transparent"
                                                        Foreground="#374151" FontSize="12"
                                                        BorderThickness="0" Cursor="Hand"/>
                                            </Border>
                                        </Grid>
                                        <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4">
                                            <StackPanel>
                                                <Grid Background="#F9FAFB" Height="36">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="130"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Document Name" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="12,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="Document Type" FontSize="10" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="Document Revision" FontSize="10" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="File Name" FontSize="10" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="Actions" FontSize="10" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center"/>
                                                </Grid>
                                                <ItemsControl x:Name="DetailDocList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="#F3F4F6" BorderThickness="0,1,0,0">
                                                                <Grid MinHeight="36">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="140"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="130"/>
                                                                        <ColumnDefinition Width="150"/>
                                                                        <ColumnDefinition Width="130"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding DocumentName}" FontSize="12" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding DocumentType}" FontSize="12" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding Revision}" FontSize="12" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding FileName}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Button Content="Open" Background="Transparent" Foreground="#2563EB"
                                                                                BorderThickness="0" FontSize="12" Cursor="Hand" Margin="0,0,8,0"
                                                                                Click="BtnOpenDoc_Click" DataContext="{Binding}"/>
                                                                        <Button Content="Download" Background="Transparent" Foreground="#2563EB"
                                                                                BorderThickness="0" FontSize="12" Cursor="Hand" Margin="0,0,8,0"
                                                                                Click="BtnDownloadDoc_Click" DataContext="{Binding}"/>
                                                                        <Button Content="Delete" Background="Transparent"
                                                                                Foreground="#DC2626" BorderThickness="0" FontSize="12" Cursor="Hand"
                                                                                Click="BtnDeleteDocDetail_Click" DataContext="{Binding}"
                                                                                Visibility="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=Tag}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Right: Spec Panel -->
                            <Border Grid.Column="1" Background="White" BorderBrush="#E5E7EB"
                                    BorderThickness="1" CornerRadius="8" Padding="16" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="Product Specification" FontSize="13"
                                               FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,14"/>

                                    <!-- DIMENSIONS -->
                                    <TextBlock Text="DIMENSIONS" FontSize="9" FontWeight="Bold"
                                               Foreground="#6B7280" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Length" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SpecLength" Grid.Column="1" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SpecLenTol" Grid.Column="2" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Width" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SpecWidth" Grid.Column="1" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SpecWidTol" Grid.Column="2" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Height" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SpecHeight" Grid.Column="1" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SpecHgtTol" Grid.Column="2" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- ELECTRICAL -->
                                    <TextBlock Text="ELECTRICAL" FontSize="9" FontWeight="Bold"
                                               Foreground="#6B7280" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Inductance" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SpecInductance" Grid.Column="1" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SpecIndTol" Grid.Column="2" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ISAAT" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SpecIsaat" Grid.Column="1" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SpecIsaatTol" Grid.Column="2" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="DCR" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SpecDcr" Grid.Column="1" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SpecDcrTol" Grid.Column="2" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- MATERIALS -->
                                    <TextBlock Text="MATERIALS" FontSize="9" FontWeight="Bold"
                                               Foreground="#6B7280" Margin="0,0,0,8"/>
                                    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <Grid Background="#F9FAFB" Height="28">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Part Number" FontSize="10" FontWeight="Bold"
                                                           Foreground="#6B7280" Margin="8,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="Part Name" FontSize="10" FontWeight="Bold"
                                                           Foreground="#6B7280" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ItemsControl x:Name="DetailMaterialList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#F3F4F6" BorderThickness="0,1,0,0">
                                                            <Grid Height="30">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding PartNumber}" FontSize="11"
                                                                           Margin="8,0" VerticalAlignment="Center" Foreground="#2563EB" FontWeight="SemiBold"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding PartName}"
                                                                           FontSize="11" VerticalAlignment="Center" Foreground="#374151"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
