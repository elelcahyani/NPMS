<Window x:Class="NPMS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="New Product Management System (NPMS)" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <Style x:Key="FilterComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ProcessTabStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#6D28D9"/>
                                <Setter Property="Foreground" Value="#6D28D9"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuBarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3E3E3E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#505050"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Background="#F1F5F9">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Menu Bar (Visual Studio Purple Gradient Style) -->
            <Border Grid.Row="0" BorderBrush="#3B0764" BorderThickness="0,0,0,1" Padding="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1E0734" Offset="0.0"/>
                        <GradientStop Color="#3B0764" Offset="0.3"/>
                        <GradientStop Color="#4C1D95" Offset="0.7"/>
                        <GradientStop Color="#6D28D9" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Nav Menu Items -->
                    <Menu Grid.Column="0" Background="Transparent" Foreground="#F3E8FF" FontSize="13" VerticalAlignment="Center">
                        <Menu.Resources>
                            <!-- Top-level Menu item style with dynamic arrow -->
                            <Style TargetType="MenuItem">
                                <Setter Property="Padding" Value="14,6"/>
                                <Setter Property="Foreground" Value="#F3E8FF"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Border x:Name="Border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="Arrow" Grid.Column="1" Text=" ▾" FontSize="9" Margin="4,1,0,0"
                                                               Foreground="#D8B4FE" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                    <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                                           Placement="Bottom" PopupAnimation="Fade" VerticalOffset="2">
                                                        <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="3"
                                                                SnapsToDevicePixels="True">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#20000000" Opacity="0.15"/>
                                                            </Border.Effect>
                                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="HasItems" Value="True">
                                                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsSubmenuOpen" Value="True">
                                                    <Setter TargetName="Arrow" Property="Text" Value=" ▴"/>
                                                    <Setter TargetName="Border" Property="Background" Value="#3B0764"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#3B0764"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Submenu Item style (no dark background, purple font, soft lavender hover) -->
                            <Style x:Key="SubMenuItemStyle" TargetType="MenuItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#260943"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="14,6"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}" CornerRadius="3" Margin="2,1">
                                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F3E8FF"/>
                                                    <Setter Property="Foreground" Value="#4C1D95"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Menu.Resources>
                        
                        <MenuItem Header="Dashboard" Name="BtnNavDashboard" Click="NavDashboard_Click"/>
                        
                        <MenuItem Header="Store" Name="BtnNavStore">
                            <MenuItem Header="Material" Name="BtnNavStoreMaterial" Style="{StaticResource SubMenuItemStyle}" Click="NavStoreMaterial_Click"/>
                            <MenuItem Header="Tooling" Name="BtnNavStoreTooling" Style="{StaticResource SubMenuItemStyle}" Click="NavStoreTooling_Click"/>
                        </MenuItem>
                        
                        <MenuItem Header="Settings" Name="BtnNavSettings">
                            <MenuItem Header="Setting Account" Name="BtnNavSettingsAccount" Style="{StaticResource SubMenuItemStyle}" Click="NavSettings_Click"/>
                            <MenuItem Header="Your Account" Name="BtnNavSettingsYourAccount" Style="{StaticResource SubMenuItemStyle}" Click="NavYourAccount_Click"/>
                        </MenuItem>
                    </Menu>

                    <!-- Center Column -->
                    <Grid Grid.Column="1"></Grid>

                    <!-- Search -->
                    <Border Grid.Column="2" BorderBrush="#581C87" BorderThickness="1" CornerRadius="4"
                            Background="#260943" Width="220" Height="26" Margin="0,0,16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;"
                                       Foreground="#C084FC" FontSize="11"
                                       Margin="8,0,5,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtSearch" Grid.Column="1"
                                     Text="Search Part Number or Product Name..."
                                     Foreground="#FFFFFF" FontSize="12"
                                     VerticalContentAlignment="Center" Padding="0,0,10,0"
                                     BorderThickness="0" Background="Transparent"
                                     GotFocus="TxtSearch_GotFocus" LostFocus="TxtSearch_LostFocus"
                                     KeyUp="TxtSearch_KeyUp"/>
                        </Grid>
                    </Border>

                    <!-- User Info + Logout -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtUserName" Text="User" Foreground="#FFFFFF" FontWeight="SemiBold"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock x:Name="TxtUserRole" Text="" Foreground="#E9D5FF"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="BtnLogout" Click="BtnLogout_Click"
                                ToolTip="Logout" Background="Transparent" BorderThickness="0"
                                Foreground="#E9D5FF" Cursor="Hand" Padding="4" Height="32">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xF3B1;" FontSize="13"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1" Background="#F1F5F9">

                <!-- LIST VIEW -->
                <Grid x:Name="ViewList" Visibility="Visible" Margin="16,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Breadcrumb -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Dashboard" Foreground="#666666" FontSize="11"/>
                        <TextBlock Text=" > " Foreground="#888888" FontSize="11"/>
                        <TextBlock Text="Product Database" Foreground="#222222" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Title + Add Button -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Product Database" FontSize="18" FontWeight="SemiBold" Foreground="#1F1F1F"/>
                            <TextBlock Text="Search and manage product information"
                                       Foreground="#666666" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border x:Name="BtnAddProductBorder" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="#6D28D9" CornerRadius="4" Visibility="Collapsed">
                            <Button x:Name="BtnAddProduct" Click="BtnAddProduct_Click"
                                    Content="+ Add New Product" Height="28" Padding="14,0"
                                    Background="Transparent" Foreground="White"
                                    FontWeight="SemiBold" FontSize="12" BorderThickness="0" Cursor="Hand"/>
                        </Border>
                    </Grid>

                    <!-- Filter Bar -->
                    <Border Grid.Row="2" Background="White" BorderBrush="#DCDCDC" BorderThickness="1"
                            CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="CmbFilterPartType" Style="{StaticResource FilterComboStyle}"
                                          Width="140" Margin="0,0,8,0" SelectionChanged="Filter_SelectionChanged">
                                    <ComboBoxItem Content="All Part Numbers" IsSelected="True"/>
                                </ComboBox>
                                <ComboBox x:Name="CmbFilterFamily" Style="{StaticResource FilterComboStyle}"
                                          Width="160" Margin="0,0,8,0" SelectionChanged="Filter_SelectionChanged">
                                    <ComboBoxItem Content="All Product Families" IsSelected="True"/>
                                    <ComboBoxItem Content="Magnetic Components"/>
                                    <ComboBoxItem Content="Sensing Components"/>
                                </ComboBox>
                                <ComboBox x:Name="CmbFilterStatus" Style="{StaticResource FilterComboStyle}"
                                          Width="130" Margin="0,0,8,0" SelectionChanged="Filter_SelectionChanged">
                                    <ComboBoxItem Content="All Statuses" IsSelected="True"/>
                                    <ComboBoxItem Content="Released"/>
                                    <ComboBoxItem Content="Draft"/>
                                    <ComboBoxItem Content="In Development"/>
                                    <ComboBoxItem Content="Obsolete"/>
                                    <ComboBoxItem Content="Discontinued"/>
                                    <ComboBoxItem Content="Pending Review"/>
                                </ComboBox>
                                <ComboBox x:Name="CmbFilterFactory" Style="{StaticResource FilterComboStyle}"
                                          Width="140" Margin="0,0,8,0" SelectionChanged="Filter_SelectionChanged">
                                    <ComboBoxItem Content="All Factories" IsSelected="True"/>
                                    <ComboBoxItem Content="Bintan"/>
                                    <ComboBoxItem Content="Alpha Facility"/>
                                    <ComboBoxItem Content="Beta Facility"/>
                                    <ComboBoxItem Content="Gamma Facility"/>
                                    <ComboBoxItem Content="Delta Facility"/>
                                    <ComboBoxItem Content="Epsilon Facility"/>
                                </ComboBox>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Click="BtnClearFilters_Click"
                                    Content="Clear Filters" Background="Transparent"
                                    Foreground="#6D28D9" FontWeight="SemiBold" FontSize="12"
                                    BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Product Table -->
                    <Border Grid.Row="3" Background="White" BorderBrush="#DCDCDC" BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
                        <Grid>
                            <DataGrid x:Name="GridProducts" AutoGenerateColumns="False"
                                      IsReadOnly="True" GridLinesVisibility="None"
                                      HeadersVisibility="Column" RowHeight="30"
                                      Background="White" BorderThickness="0"
                                      ColumnHeaderHeight="30" SelectionMode="Single"
                                      HorizontalScrollBarVisibility="Auto"
                                      SnapsToDevicePixels="True" UseLayoutRounding="True"
                                      MouseDoubleClick="GridProducts_MouseDoubleClick">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F6F6F6"/>
                                        <Setter Property="Foreground" Value="#333333"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="8,0,8,0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#EAEAEA"/>
                                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#EAEAEA"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FAF5FF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="8,0,8,0"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="Transparent"
                                                            BorderThickness="0"
                                                            Padding="{TemplateBinding Padding}"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#111827"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Part Number" Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding PartNumber}"
                                                           Foreground="#6D28D9" FontWeight="SemiBold"
                                                           FontSize="12" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="4*" MinWidth="160" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Product Family" Binding="{Binding ProductFamily}" Width="3*" MinWidth="140"/>
                                    <DataGridTextColumn Header="Product Group" Binding="{Binding ProductGroup}" Width="3*" MinWidth="130"/>
                                    <DataGridTextColumn Header="Product Type" Binding="{Binding ProductType}" Width="105"/>
                                    <DataGridTemplateColumn Header="Status" Width="95">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold"
                                                           FontSize="12" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#374151"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Released">
                                                                    <Setter Property="Foreground" Value="#107C41"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Draft">
                                                                    <Setter Property="Foreground" Value="#5C5C5C"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="In Development">
                                                                    <Setter Property="Foreground" Value="#6D28D9"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Pending Review">
                                                                    <Setter Property="Foreground" Value="#BC4B00"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Obsolete">
                                                                    <Setter Property="Foreground" Value="#767676"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Discontinued">
                                                                    <Setter Property="Foreground" Value="#C42B1C"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Factory" Binding="{Binding Factory}" Width="120"/>
                                    <DataGridTemplateColumn Header="Last Modified" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LastModified, StringFormat='{}{0:dd MMM yyyy}'}"
                                                           FontSize="12" Foreground="#666666"
                                                           VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Empty State Overlay -->
                            <StackPanel x:Name="EmptyStateMessage" Visibility="Collapsed" 
                                        VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,30,0,0">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" 
                                           FontSize="36" Foreground="#B0B0B0" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="No products found" FontSize="15" FontWeight="SemiBold" 
                                           Foreground="#555555" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="We couldn't find any products matching your search or filters." 
                                           FontSize="12" Foreground="#777777" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- DETAIL VIEW -->
                <Grid x:Name="ViewDetail" Visibility="Collapsed" Margin="16,12,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Breadcrumb -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Dashboard" Foreground="#666666" FontSize="11" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{x:Null}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text=" > " Foreground="#888888" FontSize="11"/>
                        <TextBlock Text="Product Database" Foreground="#666666" FontSize="11" Cursor="Hand" MouseDown="BtnBackToList_Click"/>
                        <TextBlock Text=" > " Foreground="#888888" FontSize="11"/>
                        <TextBlock x:Name="BreadcrumbProduct" Text="" Foreground="#222222" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Title Bar + Action Buttons -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="DetailTitle" Text="" FontSize="18" FontWeight="Bold" Foreground="#1F1F1F"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Read-only badge for non-R&D -->
                            <Border x:Name="BadgeAccess" Background="#F3E8FF" BorderBrush="#C4B5FD" BorderThickness="1"
                                    CornerRadius="4" Padding="10,4" Margin="0,0,8,0" Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock Text="🔒 Read Only" FontSize="11" Foreground="#6D28D9" FontWeight="SemiBold"/>
                            </Border>
                            <!-- Upload Doc -->
                            <Border x:Name="BtnUploadDocBorder" Background="#0D9488" CornerRadius="4" Margin="0,0,8,0" Visibility="Collapsed">
                                <Button x:Name="BtnUploadDoc" Click="BtnUploadDoc_Click" Padding="12,6"
                                        Background="Transparent" Foreground="White" FontWeight="SemiBold"
                                        FontSize="12" BorderThickness="0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE898;" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Upload Doc" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                            <!-- Edit -->
                            <Border x:Name="BtnEditProductBorder" Background="#6D28D9" CornerRadius="4" Margin="0,0,8,0" Visibility="Collapsed">
                                <Button x:Name="BtnEditProduct" Click="BtnEditProduct_Click" Padding="12,6"
                                        Background="Transparent" Foreground="White" FontWeight="SemiBold"
                                        FontSize="12" BorderThickness="0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Edit Product" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                            <!-- Delete -->
                            <Border x:Name="BtnDeleteProductBorder" Background="#DC2626" CornerRadius="4" Visibility="Collapsed">
                                <Button x:Name="BtnDeleteProduct" Click="BtnDeleteProduct_Click" Padding="12,6"
                                        Background="Transparent" Foreground="White" FontWeight="SemiBold"
                                        FontSize="12" BorderThickness="0" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Delete" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                            <!-- Back -->
                            <Button Click="BtnBackToList_Click" Padding="12,6" Margin="8,0,0,0"
                                    Background="Transparent" Foreground="#6B7280" FontSize="12"
                                    BorderBrush="#D1D5DB" BorderThickness="1" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Back" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Detail Body: Two column layout -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT PANEL: Image + Core Info + Manufacturing + Spec -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <!-- Product Image Card -->
                                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="PRODUCT IMAGE" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,10"/>
                                        <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6"
                                                Background="#F9FAFB" Height="160" ClipToBounds="True">
                                            <Grid>
                                                <Image x:Name="ImgProduct" Stretch="UniformToFill"
                                                       Visibility="Collapsed"/>
                                                <StackPanel x:Name="TxtNoImage" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEB9F;"
                                                               FontSize="36" Foreground="#D1D5DB" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="No image" FontSize="11" Foreground="#9CA3AF"
                                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Core Info Card -->
                                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="PRODUCT INFORMATION" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,12"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Part Number" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtDetailPn" Grid.Column="1" FontSize="12" FontWeight="Bold" Foreground="#6D28D9" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Product Name" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtDetailName" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="#111827" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Family" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtDetailFamily" Grid.Column="1" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Group" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtDetailGroup" Grid.Column="1" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Type" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtDetailType" Grid.Column="1" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Revision" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtDetailRevision" Grid.Column="1" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Status" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtDetailStatus" Grid.Column="1" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Created By" FontSize="11" Foreground="#6B7280" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="TxtDetailCreatedBy" Grid.Column="1" FontSize="12" Foreground="#374151" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Last Updated" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtDetailUpdatedAt" Grid.Column="1" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Separator Margin="0,4,0,8" Background="#F3F4F6"/>
                                        <TextBlock Text="DESCRIPTION" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="TxtDetailDesc" FontSize="12" Foreground="#374151" TextWrapping="Wrap" LineHeight="18"/>
                                    </StackPanel>
                                </Border>

                                <!-- Manufacturing Info Card -->
                                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="MANUFACTURING" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,12"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Factory" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtDetailFactory" Grid.Column="1" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Line" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtDetailLine" Grid.Column="1" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Prod. Type" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtDetailProdType" Grid.Column="1" FontSize="12" Foreground="#374151" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="Notes" FontSize="11" Foreground="#6B7280" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtDetailMfgNotes" FontSize="12" Foreground="#374151" TextWrapping="Wrap" LineHeight="18"/>
                                    </StackPanel>
                                </Border>

                                <!-- Specification Card -->
                                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="SPECIFICATIONS" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,12"/>

                                        <!-- Dimensions -->
                                        <TextBlock Text="Dimensions (mm)" FontSize="11" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Length" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SpecLength" Grid.Column="1" FontSize="12" Foreground="#111827" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"/>
                                            <TextBlock Text="± Tol" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SpecLenTol" Grid.Column="4" FontSize="12" Foreground="#6D28D9" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Width" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SpecWidth" Grid.Column="1" FontSize="12" Foreground="#111827" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"/>
                                            <TextBlock Text="± Tol" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SpecWidTol" Grid.Column="4" FontSize="12" Foreground="#6D28D9" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Height" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SpecHeight" Grid.Column="1" FontSize="12" Foreground="#111827" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"/>
                                            <TextBlock Text="± Tol" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SpecHgtTol" Grid.Column="4" FontSize="12" Foreground="#6D28D9" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Electrical -->
                                        <TextBlock Text="Electrical" FontSize="11" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Inductance" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SpecInductance" Grid.Column="1" FontSize="12" Foreground="#111827" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"/>
                                            <TextBlock Text="± Tol" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SpecIndTol" Grid.Column="4" FontSize="12" Foreground="#6D28D9" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Isat" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SpecIsaat" Grid.Column="1" FontSize="12" Foreground="#111827" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"/>
                                            <TextBlock Text="± Tol" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SpecIsaatTol" Grid.Column="4" FontSize="12" Foreground="#6D28D9" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="DCR" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SpecDcr" Grid.Column="1" FontSize="12" Foreground="#111827" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"/>
                                            <TextBlock Text="± Tol" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SpecDcrTol" Grid.Column="4" FontSize="12" Foreground="#6D28D9" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- RIGHT PANEL: Tabs (Process / Documents / Materials) -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Process Tabs Header Bar -->
                            <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Padding="4,4,4,0">
                                <WrapPanel x:Name="DetailProcessTabBar" Orientation="Horizontal"/>
                            </Border>

                            <!-- Tabs Content Area -->
                            <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="0,0,8,8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                                    <StackPanel>

                                        <!-- Process Detail Panel -->
                                        <StackPanel x:Name="DetailProcessPanel" Visibility="Collapsed">
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="PROCESS NAME" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                                    <TextBlock x:Name="DetailProcessName" FontSize="14" FontWeight="Bold" Foreground="#1F1F1F"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="MACHINE" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                                    <TextBlock x:Name="DetailMachine" FontSize="13" Foreground="#374151"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="TOOLING" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                                    <TextBlock x:Name="DetailTooling" FontSize="13" Foreground="#374151"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="PROCESS DESCRIPTION" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                                            <TextBlock x:Name="DetailProcessDesc" FontSize="12" Foreground="#374151" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16"/>

                                            <TextBlock Text="PROCESS PARAMETERS" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                                            <DataGrid x:Name="DetailParamList" AutoGenerateColumns="False"
                                                      IsReadOnly="True" GridLinesVisibility="None"
                                                      HeadersVisibility="Column" RowHeight="28"
                                                      Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                                      ColumnHeaderHeight="28" SelectionMode="Single">
                                                <DataGrid.ColumnHeaderStyle>
                                                    <Style TargetType="DataGridColumnHeader">
                                                        <Setter Property="Background" Value="#F9FAFB"/>
                                                        <Setter Property="Foreground" Value="#374151"/>
                                                        <Setter Property="FontSize" Value="11"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Padding" Value="8,0"/>
                                                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    </Style>
                                                </DataGrid.ColumnHeaderStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Parameter" Binding="{Binding ParameterName}" Width="*"/>
                                                    <DataGridTextColumn Header="Value" Binding="{Binding ParameterValue}" Width="100"/>
                                                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>

                                        <Separator Margin="0,16" Background="#E5E7EB"/>

                                        <!-- Documents Section -->
                                        <TextBlock Text="DOCUMENTS" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,10"/>
                                        <ItemsControl x:Name="DetailDocList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6"
                                                            Background="#FAFAFA" Padding="12,8" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding DocumentName}" FontSize="12" FontWeight="SemiBold" Foreground="#1F1F1F"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <TextBlock Text="{Binding DocumentType}" FontSize="11" Foreground="#6B7280"/>
                                                                    <TextBlock Text=" · Rev " FontSize="11" Foreground="#9CA3AF"/>
                                                                    <TextBlock Text="{Binding Revision}" FontSize="11" Foreground="#6B7280"/>
                                                                    <TextBlock Text=" · " FontSize="11" Foreground="#9CA3AF"/>
                                                                    <TextBlock Text="{Binding UploadedBy}" FontSize="11" Foreground="#6B7280"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Click="BtnOpenDoc_Click" Background="Transparent" BorderThickness="0"
                                                                        Cursor="Hand" ToolTip="Open" Padding="4,2" Margin="0,0,4,0">
                                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A7;" FontSize="13" Foreground="#6D28D9"/>
                                                                </Button>
                                                                <Button Click="BtnDownloadDoc_Click" Background="Transparent" BorderThickness="0"
                                                                        Cursor="Hand" ToolTip="Download" Padding="4,2" Margin="0,0,4,0">
                                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="13" Foreground="#0D9488"/>
                                                                </Button>
                                                                <Button Click="BtnDeleteDocDetail_Click" Background="Transparent" BorderThickness="0"
                                                                        Cursor="Hand" ToolTip="Delete"
                                                                        Visibility="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=Tag}"
                                                                        Padding="4,2">
                                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="13" Foreground="#DC2626"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Separator Margin="0,16" Background="#E5E7EB"/>

                                        <!-- Materials Section -->
                                        <TextBlock Text="BILL OF MATERIALS" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,10"/>
                                        <DataGrid x:Name="DetailMaterialList" AutoGenerateColumns="False"
                                                  IsReadOnly="True" GridLinesVisibility="None"
                                                  HeadersVisibility="Column" RowHeight="28"
                                                  Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                                  ColumnHeaderHeight="28" SelectionMode="Single">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="#F9FAFB"/>
                                                    <Setter Property="Foreground" Value="#374151"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Padding" Value="8,0"/>
                                                    <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Part Number" Binding="{Binding PartNumber}" Width="130" FontWeight="SemiBold"/>
                                                <DataGridTextColumn Header="Part Name" Binding="{Binding PartName}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- MATERIAL INVENTORY VIEW -->
                <Grid x:Name="ViewMaterial" Visibility="Collapsed" Margin="16,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Breadcrumb -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Dashboard" Foreground="#666666" FontSize="11"/>
                        <TextBlock Text=" > " Foreground="#888888" FontSize="11"/>
                        <TextBlock Text="Store" Foreground="#666666" FontSize="11"/>
                        <TextBlock Text=" > " Foreground="#888888" FontSize="11"/>
                        <TextBlock Text="Material Inventory" Foreground="#222222" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Title Header + Add Button -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Material Inventory" FontSize="18" FontWeight="Bold" Foreground="#1E0734"/>
                            <TextBlock Text="Manage material inventory linked to product part numbers from the Product Dashboard"
                                       Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border x:Name="BtnAddMaterialBorder" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="#6D28D9" CornerRadius="6" Visibility="Visible">
                            <Button x:Name="BtnAddMaterial" Click="BtnAddMaterial_Click" Padding="14,8"
                                    Background="Transparent" Foreground="White" FontWeight="Bold"
                                    FontSize="12" BorderThickness="0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Add Material" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </Grid>

                    <!-- KPI Stat Cards -->
                    <Grid Grid.Row="2" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Total Items -->
                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="TOTAL MATERIAL ITEMS" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock x:Name="TxtStatTotalItems" Text="0" FontSize="20" FontWeight="Bold" Foreground="#1E0734" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Total Qty -->
                        <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="TOTAL STOCK QUANTITY" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock x:Name="TxtStatTotalQty" Text="0" FontSize="20" FontWeight="Bold" Foreground="#0D9488" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Active Lots -->
                        <Border Grid.Column="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="ACTIVE LOTS" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock x:Name="TxtStatTotalLots" Text="0" FontSize="20" FontWeight="Bold" Foreground="#6D28D9" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Locations -->
                        <Border Grid.Column="6" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="STORAGE LOCATIONS" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock x:Name="TxtStatTotalLocations" Text="0" FontSize="20" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Filter & Search Bar -->
                    <Border Grid.Row="3" Background="White" BorderBrush="#DCDCDC" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Material Search Box -->
                                <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4"
                                        Background="#F8FAFC" Width="240" Height="30" Margin="0,0,12,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;"
                                                   Foreground="#64748B" FontSize="11"
                                                   Margin="8,0,5,0" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtSearchMaterialInput" Grid.Column="1"
                                                 Text=""
                                                 Foreground="#1E0734" FontSize="11"
                                                 VerticalContentAlignment="Center" Padding="0,0,8,0"
                                                 BorderThickness="0" Background="Transparent"
                                                 KeyUp="TxtSearchMaterial_KeyUp">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Background">
                                                                <Setter.Value>
                                                                    <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                                        <VisualBrush.Visual>
                                                                            <TextBlock Text="Search Part No, Description, Lot, Location..."
                                                                                       Foreground="#94A3B8" FontSize="11" Margin="2,0,0,0"/>
                                                                        </VisualBrush.Visual>
                                                                    </VisualBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>
                                </Border>

                                <!-- Part Number Filter -->
                                <ComboBox x:Name="CmbFilterMaterialPartNumber" Width="140" Height="30" Margin="0,0,14,0"
                                          FontSize="11" VerticalContentAlignment="Center" SelectionChanged="MaterialFilter_SelectionChanged">
                                    <ComboBoxItem Content="All Part Numbers" IsSelected="True"/>
                                </ComboBox>

                                <!-- Lot Filter -->
                                <ComboBox x:Name="CmbFilterMaterialLot" Width="110" Height="30" Margin="0,0,10,0"
                                          FontSize="11" VerticalContentAlignment="Center" SelectionChanged="MaterialFilter_SelectionChanged">
                                    <ComboBoxItem Content="All Lots" IsSelected="True"/>
                                </ComboBox>
                            </StackPanel>

                            <Button HorizontalAlignment="Right" Click="BtnClearMaterialFilters_Click"
                                    Content="Clear Filters" Background="Transparent"
                                    Foreground="#6D28D9" FontWeight="SemiBold" FontSize="12"
                                    BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Material DataGrid Table -->
                    <Border Grid.Row="4" Background="White" BorderBrush="#DCDCDC" BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
                        <Grid>
                            <DataGrid x:Name="GridStoreMaterials" AutoGenerateColumns="False"
                                      IsReadOnly="True" GridLinesVisibility="None"
                                      HeadersVisibility="Column" RowHeight="32"
                                      Background="White" BorderThickness="0"
                                      ColumnHeaderHeight="32" SelectionMode="Single"
                                      HorizontalScrollBarVisibility="Auto"
                                      SnapsToDevicePixels="True" UseLayoutRounding="True"
                                      MouseDoubleClick="GridStoreMaterials_MouseDoubleClick">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F6F6F6"/>
                                        <Setter Property="Foreground" Value="#1E0734"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="8,0,8,0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#EAEAEA"/>
                                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#F3E8FF"/>
                                                <Setter Property="BorderBrush" Value="#D8B4FE"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FAF5FF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="8,0,8,0"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="Transparent"
                                                            BorderThickness="0"
                                                            Padding="{TemplateBinding Padding}"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="#111827"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>

                                <DataGrid.Columns>
                                    <!-- Part Number -->
                                    <DataGridTemplateColumn Header="Part Number" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PartNumber}" Foreground="#6D28D9" FontWeight="Bold" FontSize="12"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Tanggal Masuk -->
                                    <DataGridTemplateColumn Header="Entry Date" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding EntryDate, StringFormat='{}{0:dd MMM yyyy}'}"
                                                           FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Item Description -->
                                    <DataGridTextColumn Header="Item Description" Binding="{Binding ItemDescription}" Width="2*" MinWidth="180" FontWeight="SemiBold"/>

                                    <!-- Item Code -->
                                    <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode}" Width="105"/>

                                    <!-- UoM -->
                                    <DataGridTextColumn Header="UoM" Binding="{Binding UoM}" Width="70"/>

                                    <!-- Lot -->
                                    <DataGridTemplateColumn Header="Lot" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Lot}" FontFamily="Consolas" FontSize="11" Foreground="#0F172A" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Location -->
                                    <DataGridTemplateColumn Header="Location" Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Location}" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Qty -->
                                    <DataGridTemplateColumn Header="Qty" Width="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Qty, StringFormat='{}{0:N0}'}" FontWeight="Bold" Foreground="#0D9488"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Package -->
                                    <DataGridTextColumn Header="Package" Binding="{Binding Package}" Width="100"/>

                                    <!-- Remarks -->
                                    <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="160"/>

                                    <!-- Actions (Edit / Delete) -->
                                    <DataGridTemplateColumn Header="Actions" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Click="BtnEditStoreMaterial_Click" Background="Transparent" BorderThickness="0"
                                                            Cursor="Hand" ToolTip="Edit Material" Padding="4,2" Margin="0,0,4,0">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="12" Foreground="#6D28D9"/>
                                                    </Button>
                                                    <Button Click="BtnDeleteStoreMaterial_Click" Background="Transparent" BorderThickness="0"
                                                            Cursor="Hand" ToolTip="Delete Material" Padding="4,2">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="12" Foreground="#DC2626"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Empty State Overlay -->
                            <StackPanel x:Name="MaterialEmptyStateMessage" Visibility="Collapsed" 
                                        VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,30,0,0">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" 
                                           FontSize="36" Foreground="#B0B0B0" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="No material records found" FontSize="15" FontWeight="SemiBold" 
                                           Foreground="#666666" HorizontalAlignment="Center"/>
                                <TextBlock Text="Try adjusting filters or add a new material record" 
                                           FontSize="12" Foreground="#999999" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- TOOLING VIEW -->
                <Grid x:Name="ViewTooling" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="64" Foreground="#B0B0B0" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="Tooling Module" FontSize="24" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="This module is currently under development." FontSize="14" Foreground="#64748B" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>


            </Grid>
        </Grid>
    </Grid>
</Window>
