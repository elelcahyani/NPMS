<Window x:Class="NPMS.Desktop.StoreMaterialFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Material Inventory Form" Height="620" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI" FontSize="12">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,18">
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="TxtTitle" Text="Add New Material" FontSize="18" FontWeight="Bold" Foreground="#1E0734"/>
                    <TextBlock Text="Part Number is linked directly to the Material Part Number on the Product Dashboard" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
            <StackPanel Margin="0,0,8,0">

                <!-- Row 1: Part Number & Tanggal Masuk -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Part Number" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock Text=" *" Foreground="#DC2626" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                        <ComboBox x:Name="CmbPartNumber" Height="36" BorderBrush="#CBD5E1" FontSize="12"
                                  Background="White" Padding="8,0" VerticalContentAlignment="Center"
                                  SelectionChanged="CmbPartNumber_SelectionChanged"/>
                        <TextBlock Text="Select a part number from the Product Dashboard materials" FontSize="10" Foreground="#94A3B8" Margin="2,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Entry Date" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock Text=" *" Foreground="#DC2626" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                        <DatePicker x:Name="DpEntryDate" Height="36" BorderBrush="#CBD5E1" FontSize="12"
                                    VerticalContentAlignment="Center" Padding="4,0"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Item Code & Item Description -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Item Code" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtItemCode" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                                 BorderBrush="#CBD5E1" BorderThickness="1" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Item Description" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock Text=" *" Foreground="#DC2626" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBox x:Name="TxtItemDescription" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                                 BorderBrush="#CBD5E1" BorderThickness="1" FontSize="12"/>
                    </StackPanel>
                </Grid>

                <!-- Row 3: UoM, Lot, Package -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="UoM (Unit)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbUoM" Height="36" BorderBrush="#CBD5E1" FontSize="12"
                                  Background="White" Padding="8,0" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="PCS" IsSelected="True"/>
                            <ComboBoxItem Content="KG"/>
                            <ComboBoxItem Content="REEL"/>
                            <ComboBoxItem Content="METER"/>
                            <ComboBoxItem Content="BOX"/>
                            <ComboBoxItem Content="SET"/>
                            <ComboBoxItem Content="ROLL"/>
                            <ComboBoxItem Content="TUBE"/>
                            <ComboBoxItem Content="CARTON"/>
                            <ComboBoxItem Content="TRAY"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Lot Number" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtLot" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                                 BorderBrush="#CBD5E1" BorderThickness="1" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Package" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPackage" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                                 BorderBrush="#CBD5E1" BorderThickness="1" FontSize="12"/>
                    </StackPanel>
                </Grid>

                <!-- Row 4: Location & Quantity -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Storage Location" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock Text=" *" Foreground="#DC2626" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBox x:Name="TxtLocation" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                                 BorderBrush="#CBD5E1" BorderThickness="1" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Quantity (Qty)" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock Text=" *" Foreground="#DC2626" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBox x:Name="TxtQty" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                                 BorderBrush="#CBD5E1" BorderThickness="1" FontSize="12"/>
                    </StackPanel>
                </Grid>

                <!-- Row 5: Remarks -->
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Remarks / Notes" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtRemarks" Height="64" Padding="10,8" VerticalContentAlignment="Top"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             BorderBrush="#CBD5E1" BorderThickness="1" FontSize="12"/>
                </StackPanel>

                <!-- Error Display -->
                <TextBlock x:Name="TxtError" Text="" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold"
                           Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2">
            <Button Content="Cancel" Click="BtnCancel_Click" HorizontalAlignment="Left"
                    Width="100" Height="38" Background="White" Foreground="#475569"
                    BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold"/>
            <Border HorizontalAlignment="Right" Background="#6D28D9" CornerRadius="6">
                <Button x:Name="BtnSave" Content="Save Material" Click="BtnSave_Click"
                        Width="140" Height="38" Background="Transparent"
                        Foreground="White" FontWeight="Bold" FontSize="12"
                        BorderThickness="0" Cursor="Hand"/>
            </Border>
        </Grid>
    </Grid>
</Window>
