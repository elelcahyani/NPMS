<Window x:Class="NPMS.Desktop.ToolingFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tooling Inventory" Height="640" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" FontFamily="Segoe UI" FontSize="12">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TxtTitle" Text="Add Tooling Inventory" FontSize="18"
                   FontWeight="Bold" Foreground="#1E0734" Margin="0,0,0,14"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Part Number" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox x:Name="TxtPartNumber" Grid.Column="1" Height="32" Margin="0,4" Padding="8,4"/>
            <TextBlock Grid.Row="1" Text="Tooling Name" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox x:Name="TxtToolingName" Grid.Row="1" Grid.Column="1" Height="32" Margin="0,4" Padding="8,4"/>
            <TextBlock Grid.Row="2" Text="Entry Date" VerticalAlignment="Center" Margin="0,5"/>
            <DatePicker x:Name="DpEntryDate" Grid.Row="2" Grid.Column="1" Height="32" Margin="0,4"/>
            <TextBlock Grid.Row="3" Text="Item Code" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox x:Name="TxtItemCode" Grid.Row="3" Grid.Column="1" Height="32" Margin="0,4" Padding="8,4"/>
            <TextBlock Grid.Row="4" Text="PN Product" VerticalAlignment="Center" Margin="0,5"/>
            <ComboBox x:Name="CmbProductPartNumber" Grid.Row="4" Grid.Column="1" Height="32" Margin="0,4"
                      Padding="8,4" DisplayMemberPath="PartNumber" SelectedValuePath="PartNumber"
                      SelectionChanged="CmbProductPartNumber_SelectionChanged"/>
            <TextBlock Grid.Row="5" Text="P Family" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox x:Name="TxtProductFamily" Grid.Row="5" Grid.Column="1" Height="32" Margin="0,4"
                     Padding="8,4" IsReadOnly="True" Background="#F1F5F9"/>
            <TextBlock Grid.Row="6" Text="UoM" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox x:Name="TxtUoM" Grid.Row="6" Grid.Column="1" Height="32" Margin="0,4" Padding="8,4" Text="PCS"/>
            <TextBlock Grid.Row="7" Text="Lot" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox x:Name="TxtLot" Grid.Row="7" Grid.Column="1" Height="32" Margin="0,4" Padding="8,4"/>
            <TextBlock Grid.Row="8" Text="Storage Location" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox x:Name="TxtLocation" Grid.Row="8" Grid.Column="1" Height="32" Margin="0,4" Padding="8,4"/>
            <TextBlock Grid.Row="9" Text="Quantity" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox x:Name="TxtQuantity" Grid.Row="9" Grid.Column="1" Height="32" Margin="0,4" Padding="8,4"/>
            <TextBlock Grid.Row="10" Text="Package" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox x:Name="TxtPackage" Grid.Row="10" Grid.Column="1" Height="32" Margin="0,4" Padding="8,4"/>
            <TextBlock Grid.Row="11" Text="Remarks" VerticalAlignment="Center" Margin="0,5"/>
            <TextBox x:Name="TxtRemarks" Grid.Row="11" Grid.Column="1" Height="58" Margin="0,4"
                     Padding="8,5" TextWrapping="Wrap" AcceptsReturn="True"/>
            <TextBlock x:Name="TxtError" Grid.Row="12" Grid.ColumnSpan="2" Foreground="#DC2626"
                       TextWrapping="Wrap" Margin="0,8,0,0" VerticalAlignment="Top" Visibility="Collapsed"/>
        </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="BtnCancel_Click" Padding="14,7" Margin="0,0,8,0"
                    Background="White" Foreground="#475569" BorderBrush="#CBD5E1" Cursor="Hand"/>
            <Button x:Name="BtnSave" Content="Save Tooling" Click="BtnSave_Click" Padding="14,7"
                    Background="#6D28D9" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
