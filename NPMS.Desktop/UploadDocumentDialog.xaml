<Window x:Class="NPMS.Desktop.UploadDocumentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upload Document" Height="500" MinHeight="400" MaxHeight="700" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI" FontSize="12">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Document Details" FontSize="15" FontWeight="Bold"
                   Foreground="#111827" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Document Name" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtDocName" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                         BorderBrush="#D1D5DB" BorderThickness="1" FontSize="13" Margin="0,0,0,14"/>

                <TextBlock Text="Document Type" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbDocType" Height="36" BorderBrush="#D1D5DB" FontSize="13"
                          Background="White" VerticalContentAlignment="Center" Margin="0,0,0,14">
                    <ComboBoxItem Content="Work Instruction" IsSelected="True"/>
                    <ComboBoxItem Content="Drawing"/>
                    <ComboBoxItem Content="Manufacturing Specification"/>
                    <ComboBoxItem Content="Inspection Standard"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>

                <TextBlock Text="Applies To" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbProcess" Height="36" BorderBrush="#D1D5DB" FontSize="13"
                          Background="White" VerticalContentAlignment="Center" Margin="0,0,0,14">
                    <ComboBoxItem Content="All processes" Tag="" IsSelected="True"/>
                </ComboBox>
                <TextBlock Text="Choose a process to scope this document, or keep it available to all processes."
                           FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,-10,0,14"/>

                <TextBlock Text="Revision" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtRevision" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                         BorderBrush="#D1D5DB" BorderThickness="1" FontSize="13" Text="Rev.01"/>

                <TextBlock x:Name="TxtError" Text="" Foreground="#DC2626" FontSize="12"
                           Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Button Content="Cancel" Click="BtnCancel_Click" HorizontalAlignment="Left"
                    Width="90" Height="34" Background="White" Foreground="#374151"
                    BorderBrush="#D1D5DB" BorderThickness="1" Cursor="Hand"/>
            <Border HorizontalAlignment="Right" Background="#6D28D9" CornerRadius="6">
                <Button Content="Confirm Upload" Click="BtnConfirm_Click"
                        Width="130" Height="34" Background="Transparent"
                        Foreground="White" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand"/>
            </Border>
        </Grid>
    </Grid>
</Window>
